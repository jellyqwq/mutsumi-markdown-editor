{
  "name": "mutsumi-markdown-editor",
  "displayName": "Mutsumi Markdown Editor",
  "description": "A clean Vditor-based WYSIWYG Markdown editor for VuePress blogs.",
  "version": "0.0.9",
  "publisher": "jellyqwq",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "mutsumi.markdownEditor",
        "displayName": "Mutsumi Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mutsumiMarkdown.table.insertRowAbove",
        "title": "Mutsumi Markdown: Insert Table Row Above"
      },
      {
        "command": "mutsumiMarkdown.table.insertRowBelow",
        "title": "Mutsumi Markdown: Insert Table Row Below"
      },
      {
        "command": "mutsumiMarkdown.table.insertColumnLeft",
        "title": "Mutsumi Markdown: Insert Table Column Left"
      },
      {
        "command": "mutsumiMarkdown.table.insertColumnRight",
        "title": "Mutsumi Markdown: Insert Table Column Right"
      },
      {
        "command": "mutsumiMarkdown.table.deleteRow",
        "title": "Mutsumi Markdown: Delete Table Row"
      },
      {
        "command": "mutsumiMarkdown.table.deleteColumn",
        "title": "Mutsumi Markdown: Delete Table Column"
      },
      {
        "command": "mutsumiMarkdown.table.alignLeft",
        "title": "Mutsumi Markdown: Align Table Column Left"
      },
      {
        "command": "mutsumiMarkdown.table.alignCenter",
        "title": "Mutsumi Markdown: Align Table Column Center"
      },
      {
        "command": "mutsumiMarkdown.table.alignRight",
        "title": "Mutsumi Markdown: Align Table Column Right"
      },
      {
        "command": "mutsumiMarkdown.export.markdown",
        "title": "Mutsumi Markdown: Export Markdown"
      },
      {
        "command": "mutsumiMarkdown.export.html",
        "title": "Mutsumi Markdown: Export HTML"
      },
      {
        "command": "mutsumiMarkdown.export.pdf",
        "title": "Mutsumi Markdown: Export PDF"
      }
    ],
    "keybindings": [
      {
        "command": "mutsumiMarkdown.table.insertRowAbove",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.insertRowBelow",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.insertColumnLeft",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.insertColumnRight",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.deleteRow",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.deleteColumn",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.alignLeft",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.alignCenter",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      },
      {
        "command": "mutsumiMarkdown.table.alignRight",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeCustomEditorId == 'mutsumi.markdownEditor'"
      }
    ],
    "configuration": {
      "title": "Mutsumi Markdown Editor",
      "properties": {
        "mutsumiMarkdown.publicDir": {
          "type": "string",
          "default": "src/.vuepress/public",
          "description": "Workspace-relative public assets directory."
        },
        "mutsumiMarkdown.imageRoot": {
          "type": "string",
          "default": "images",
          "description": "Directory inside the public assets directory used for pasted images."
        },
        "mutsumiMarkdown.contentRoot": {
          "type": "string",
          "default": "src",
          "description": "Workspace-relative content root removed from article paths when deriving image folders."
        },
        "mutsumiMarkdown.imageName": {
          "type": "string",
          "default": "${timestamp}.${ext}",
          "description": "Pasted image file name template. Supports ${timestamp}, ${now}, ${fileName}, ${ext}, and ${originalName}."
        },
        "mutsumiMarkdown.imagePathTemplate": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative or absolute pasted image path template. Supports ${workspaceDir}, ${publicDir}, ${imageRoot}, ${contentRoot}, ${relativeDir}, ${fileName}, ${relativePath}, ${imageName}, ${timestamp}, ${now}, ${ext}, and ${originalName}. When empty, the editor uses publicDir/imageRoot/contentRoot/imageName."
        },
        "mutsumiMarkdown.markdownImagePathTemplate": {
          "type": "string",
          "default": "",
          "description": "Optional Markdown image link template. Supports the same variables as imagePathTemplate. When empty, links are derived from publicDir, such as /images/article/name.png."
        },
        "mutsumiMarkdown.outlineDefaultOpen": {
          "type": "boolean",
          "default": false,
          "description": "Controls whether the outline is open before the editor has remembered a user choice in the current workspace."
        },
        "mutsumiMarkdown.codeBlockTheme": {
          "type": "string",
          "default": "github",
          "description": "Code block preview theme used by Vditor and exported HTML/PDF files. Examples: github, github-dark, vs2015, atom-one-dark, base16/solarized-light."
        },
        "mutsumiMarkdown.chromiumPath": {
          "type": "string",
          "default": "",
          "description": "Optional Chrome or Chromium executable path used for PDF export. When empty, the editor tries to find Chrome, Chromium, or Microsoft Edge automatically."
        },
        "mutsumiMarkdown.pdfMarginTop": {
          "type": "number",
          "default": 25,
          "minimum": 0,
          "description": "Top margin in millimeters for exported PDF files."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "puppeteer-core": "^25.0.2",
    "vditor": "^3.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
